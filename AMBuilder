# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
import os

projectName = 'actions'

# smsdk_ext.cpp will be automatically added later
sourceFiles = [
  # Shared NextBot
  'source/sdk/shared/NextBotBehaviorShared.cpp',
  'source/sdk/shared/NextBotComponentInterface.cpp',
  'source/sdk/shared/NextBotInterface.cpp',
  # Actions
  'source/actions/component/component.cpp',
  'source/actions/constructor/config_parser.cpp',
  'source/actions/constructor/constructor.cpp',
  'source/actions/legacy/custom_legacy.cpp',
  'source/actions/manager/manager.cpp',
  'source/actions/processor/processor.cpp',
  'source/actions/processor/shared.cpp',
  'source/actions/processor/vtableswap.cpp',
  'source/actions/propagation/propagation.cpp',
  'source/actions/runtime/pubvars.cpp',
  'source/actions/runtime/tools.cpp',
  # Extension
  'source/hook.cpp',
  'source/extension.cpp',
  os.path.join(Extension.sm_root, 'public', 'CDetour', 'detours.cpp'),
]

gameFiles = {
  'l4d': [
    'source/sdk/l4d/actions_processor.cpp',
    'source/sdk/l4d/actions_tools_l4d.cpp',
  ],
  'l4d2': [
    'source/sdk/l4d2/actions_processor.cpp',
    'source/sdk/l4d2/actions_tools_l4d2.cpp',
  ],
  'tf2': [
    'source/sdk/tf2/actions_processor.cpp',
    'source/sdk/tf2/actions_tools_tf2.cpp',
  ],
}

# SourceMod's CDetour is built on safetyhook. Build it the way SourceMod does, from a submodule pinned to the same
# commit as SourceMod's public/safetyhook.
class SafetyHookShim(object):
  def __init__(self):
    self.all_targets = Extension.all_targets
    self.libsafetyhook = {}

SafetyHook = SafetyHookShim()
builder.Build('safetyhook/AMBuilder', {'SafetyHook': SafetyHook})

project = builder.LibraryProject(projectName)
project.sources += [os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp')]
project.sources += sourceFiles

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]
  if sdk['name'] in ['mock']:
    continue

  for cxx in builder.targets:
    if not cxx.target.arch in sdk['platforms'][cxx.target.platform]:
      continue

    binary = Extension.HL2ExtConfig(project, builder, cxx, projectName + '.ext.' + sdk['extension'], sdk)
    binary.sources += gameFiles[sdk_name]
    binary.compiler.cxxincludes += [
      os.path.join(builder.sourcePath, 'source'),
      os.path.join(builder.sourcePath, 'source', 'sdk', 'shared'),
      os.path.join(builder.sourcePath, 'source', 'sdk', sdk_name),
      os.path.join(builder.sourcePath, 'source', 'sdk', sdk_name, 'nextbot'),
      os.path.join(builder.sourcePath, 'safetyhook', 'include'),
    ]
    binary.compiler.linkflags += [task.binary for task in SafetyHook.libsafetyhook if task.target.arch == cxx.target.arch]
    binary.compiler.defines += ['INCLUDE_ACTIONS_CONSTRUCTOR']
    # Exception: carried over from upstream's build; SourceMod sets neither.
    binary.compiler.defines += [
      'HAVE_STRING_H',
      '_GLIBCXX_USE_CXX11_ABI=0',
    ]

    if binary.compiler.like('msvc'):
      # Exception: carried over from upstream's build. /GR re-enables RTTI, which the standard disables with /GR-.
      binary.compiler.defines += ['_CRT_NO_VA_START_VALIDATION']
      binary.compiler.cxxflags += ['/GR']
      binary.compiler.linkflags += ['legacy_stdio_definitions.lib']
    else:
      # Exception: carried over from upstream's build. SourceMod builds without RTTI and these warnings enabled.
      binary.compiler.cxxflags += [
        '-fexceptions',
        '-frtti',
        '-Wno-reinterpret-base-class',
        '-Wno-infinite-recursion',
        '-Wno-implicit-const-int-float-conversion',
        '-Wno-varargs',
        '-Wno-delete-non-abstract-non-virtual-dtor',
      ]

Extension.extensions += builder.Add(project)
